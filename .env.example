# App emails for contact form
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-gmail-app-password

# MongoDB connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
# The database is created automatically on the first write.
MONGODB_NAME=portfolio-v2
# Optional split form for the same connection
# MONGODB_USER=username
# MONGODB_PASS=password
# MONGODB_HOST=cluster.mongodb.net

# Cloudinary credentials (media integration is pending)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional: only needed for unsigned uploads
# CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# NextAuth / Auth.js configuration
NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL=https://your-domain.example
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Optional admin session secret
# ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Dashboard admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional alternative for a future hashed-password implementation
# ADMIN_PASSWORD_HASH=replace-with-a-password-hash